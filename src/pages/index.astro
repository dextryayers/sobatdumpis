---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import CommunityIntro from '../components/sections/CommunityIntro.astro';
import CommunityValues from '../components/sections/CommunityValues.astro';
import PeoplePreview from '../components/sections/PeoplePreview.astro';
import StoriesPreview from '../components/sections/StoriesPreview.astro';
import MomentsSection from '../components/sections/MomentsSection.astro';
import CommunityManifesto from '../components/sections/CommunityManifesto.astro';
import JoinCTA from '../components/sections/JoinCTA.astro';

const title = 'Sobat Dumpis';
const description =
  'A little random. A lot of meaning. Tempat bertemunya berbagai cerita, pemikiran, karakter, dan manusia-manusia random.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__item">Sobat Dumpis <span class="marquee__dot"></span></span>
      <span class="marquee__item">Sedikit acak <span class="marquee__dot"></span></span>
      <span class="marquee__item">Banyak makna <span class="marquee__dot"></span></span>
      <span class="marquee__item">Gabut tapi serius <span class="marquee__dot"></span></span>
      <span class="marquee__item">Tidak harus sempurna <span class="marquee__dot"></span></span>
      <span class="marquee__item">Meme-friendly community <span class="marquee__dot"></span></span>
      <span class="marquee__item">Sobat Dumpis <span class="marquee__dot"></span></span>
      <span class="marquee__item">Sedikit acak <span class="marquee__dot"></span></span>
      <span class="marquee__item">Banyak makna <span class="marquee__dot"></span></span>
      <span class="marquee__item">Gabut tapi serius <span class="marquee__dot"></span></span>
      <span class="marquee__item">Tidak harus sempurna <span class="marquee__dot"></span></span>
      <span class="marquee__item">Meme-friendly community <span class="marquee__dot"></span></span>
    </div>
  </div>
  <CommunityIntro />
  <CommunityValues />
  <PeoplePreview />
  <StoriesPreview />
  <MomentsSection />
  <CommunityManifesto />
  <JoinCTA />
</BaseLayout>
