---
import type { HTMLAttributes } from 'astro/types';
import type { Member } from '../../types';

interface Props extends HTMLAttributes<'article'> {
  m: Member;
  href?: string;
  featured?: boolean;
  index?: string;
}

const {
  m,
  href,
  featured = false,
  index,
  class: classList,
  ...rest
} = Astro.props;

const profileHref = href ?? `/people/${m.id}`;
---

<article
  class={`member-card ${featured ? 'member-card--featured' : ''} ${classList ?? ''}`.trim()}
  {...rest}
>
  <a class="member-card-link" href={profileHref} aria-label={`View ${m.name}'s profile`}>
    <div class="flex items-start justify-between gap-4">
      <img
        src={m.avatarSrc}
        alt=""
        class={`member-avatar ${featured ? 'member-avatar--lg' : ''}`}
        width="320"
        height="320"
        loading="lazy"
        decoding="async"
        data-reveal-image
      />
      {index && <span class="ed-meta" aria-hidden="true">{index}</span>}
    </div>

    <div class="mt-4 flex flex-1 flex-col">
      <h3 class="member-name">{m.name}</h3>
      <span class="member-nickname">@{m.nickname}</span>
      <p class="member-desc">{m.description}</p>
      <ul class="member-interests" aria-label={`${m.name}'s interests`}>
        {m.interests.map((interest) => <li class="member-interest">{interest}</li>)}
      </ul>
      <span class="member-profile-link" aria-hidden="true">View profile ↗</span>
    </div>
  </a>
</article>
