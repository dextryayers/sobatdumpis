---
import { AtSign, Mail, MessageCircle, Rss, Video } from '@lucide/astro';
import { site } from '../../data/site';

const communityLinks = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang', href: '/about' },
  { label: 'Orang', href: '/people' },
  { label: 'Cerita', href: '/stories' },
  { label: 'Momen', href: '/moments' },
];

const exploreLinks = [
  { label: 'Direktori Orang', href: '/people' },
  { label: 'Cerita Editorial', href: '/stories' },
  { label: 'Momen Komunitas', href: '/moments' },
  { label: 'Gabung Komunitas', href: '/join' },
];

const socialIcons: Record<string, typeof AtSign> = {
  Instagram: AtSign,
  Twitter: Rss,
  YouTube: Video,
  Discord: MessageCircle,
};

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="ed-container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label={`${site.name} — Beranda`}>
          <img src="/assets/logo.png" alt="Sobat Dumpis" width="558" height="328" />
        </a>
        <p class="mt-6 max-w-xs font-serif text-xl italic leading-snug text-ink-muted">
          A little random. A lot of meaning.
        </p>
        <p class="ed-meta mt-3">Komunitas independen — dirintis {site.establishedYear}.</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            site.socials.map((social) => {
              const Icon = socialIcons[social.platform] ?? MessageCircle;
              return (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="site-footer__social"
                  aria-label={social.platform}
                >
                  <Icon size={16} stroke-width={1.5} aria-hidden="true" />
                </a>
              );
            })
          }
          <a href={`mailto:${site.contactEmail}`} class="site-footer__social" aria-label="Email">
            <Mail size={16} stroke-width={1.5} aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="site-footer__col">
        <span class="ed-label">Halaman Komunitas</span>
        <ul class="site-footer-links mt-5">
          {
            communityLinks.map((link) => (
              <li>
                <a href={link.href} class="site-footer-link">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <span class="ed-label">Jelajahi</span>
        <ul class="site-footer-links mt-5">
          {
            exploreLinks.map((link) => (
              <li>
                <a href={link.href} class="site-footer-link">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <span class="ed-label">Kontak</span>
        <a href={`mailto:${site.contactEmail}`} class="site-footer-link mt-5 inline-block text-base font-semibold text-ink">
          {site.contactEmail}
        </a>
        <p class="ed-meta mt-4 max-w-[26ch]">
          Terbuka untuk cerita, kolaborasi, dan pertanyaan apa pun.
        </p>
        <a href="/join" class="mt-5 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-signal transition-colors hover:text-ink">
          Jadilah bagian dari kami →
        </a>
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true">
      <span>SOBAT DUMPIS<span class="dot">.</span></span>
    </div>

    <div class="site-footer__bottom">
      <p class="ed-meta" aria-label="Hak cipta">
        © {year} Sobat Dumpis — Dibuat Untuk Gabut dan Sharing
      </p>
      <p class="ed-meta">A little random. A lot of meaning.</p>
    </div>
  </div>
</footer>