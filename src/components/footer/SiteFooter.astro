---
import { AtSign, Mail, MessageCircle, Rss, Video } from '@lucide/astro';
import { site } from '../../data/site';

const footerLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'People', href: '/people' },
  { label: 'Stories', href: '/stories' },
  { label: 'Moments', href: '/moments' },
  { label: 'Join Us', href: '/join' },
];

const socialIcons: Record<string, typeof AtSign> = {
  Instagram: AtSign,
  Twitter: Rss,
  YouTube: Video,
  Discord: MessageCircle,
};

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-stone bg-paper">
  <div class="ed-container pb-10 pt-20">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-4 md:gap-14">
      <div class="col-span-2">
        <a
          href="/"
          class="inline-flex items-center gap-3"
          aria-label={`${site.name} — home`}
        >
          <img src="/assets/logo-mark.svg" alt="" class="h-6 w-6 object-contain" width="24" height="24" />
          <span class="font-display font-bold text-ink">SOBAT DUMPIS</span>
        </a>
        <p class="mt-4 max-w-xs font-serif text-lg italic text-ink-muted">
          A little random. A lot of meaning.
        </p>
        <p class="mt-3 ed-label">Established {site.establishedYear}</p>
      </div>

      <div>
        <span class="ed-label">Community Pages</span>
        <ul class="site-footer-links mt-4">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="site-footer-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <span class="ed-label">Stay Connected</span>
        <ul class="site-footer-links mt-4">
          {
            site.socials.map((social) => {
              const Icon = socialIcons[social.platform] ?? MessageCircle;
              return (
                <li>
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="site-footer-link inline-flex items-center gap-2"
                  >
                    <Icon size={15} strokeWidth={1.5} aria-hidden="true" />
                    {social.platform}
                  </a>
                </li>
              );
            })
          }
          <li>
            <a
              href={`mailto:${site.contactEmail}`}
              class="site-footer-link inline-flex items-center gap-2"
            >
              <Mail size={15} strokeWidth={1.5} aria-hidden="true" />
              {site.contactEmail}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-wordmark" aria-hidden="true">
      <span>SOBAT DUMPIS<span class="dot">.</span></span>
    </div>

    <div
      class="mt-8 flex flex-col gap-3 border-t border-stone pt-6 md:flex-row md:items-center md:justify-between"
    >
      <p class="ed-meta" aria-label="Copyright">
        © {year} {site.name} — Established {site.establishedYear}
      </p>
      <p class="ed-meta">Editorial — A little order in a beautifully random world.</p>
    </div>
  </div>
</footer>
