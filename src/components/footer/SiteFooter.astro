---
import { site } from '../../data/site';

const footerLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'People', href: '/people' },
  { label: 'Stories', href: '/stories' },
  { label: 'Moments', href: '/moments' },
  { label: 'Join Us', href: '/join' },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-stone bg-paper mt-24">
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-14">
      <div class="col-span-2">
        <a
          href="/"
          class="flex items-center gap-3 font-display font-bold text-ink"
          aria-label={`${site.name} home`}
        >
          <img src="/assets/logo-mark.svg" alt="" class="h-6 w-6 object-contain" />
          <span>SOBAT DUMPIS</span>
        </a>
        <p class="mt-4 t-serif text-lg italic text-ink-muted max-w-xs">
          A little random. A lot of meaning.
        </p>
        <p class="mt-2 ed-label">Established {site.establishedYear}</p>
      </div>

      <div>
        <span class="ed-label">Community Pages</span>
        <ul class="site-footer-links">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="site-footer-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <span class="ed-label">Stay Connected</span>
        <ul class="site-footer-links">
          {
            site.socials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="site-footer-link"
                >
                  {social.platform}
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${site.contactEmail}`} class="site-footer-link">
              {site.contactEmail}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-stone mt-16 pt-8 flex flex-col gap-3 md:flex-row md:justify-between md:items-center">
        <p class="ed-label" aria-label="Copyright">
        © {site.name} — Established {site.establishedYear}
      </p>
        <p class="ed-label" aria-label="Editorial footer metadata">
        Editorial — A little random. A lot of meaning.
      </p>
    </div>
  </div>
</footer>
