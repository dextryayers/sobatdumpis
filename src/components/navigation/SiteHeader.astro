---
import { navLinks } from '../../data/navigation';
import { site } from '../../data/site';

const currentPath = Astro.url.pathname;
const normalized = (path: string) =>
  path !== '/' && path.endsWith('/') ? path.slice(0, -1) : path;
const activePath = normalized(currentPath);

const isActive = (href: string) =>
  activePath === href || (href !== '/' && activePath.startsWith(`${href}/`));
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-stone bg-paper/95 backdrop-blur-sm"
  data-animate="nav"
>
  <div class="ed-container flex h-16 items-center justify-between gap-6 md:h-20">
    <a
      href="/"
      class="group flex items-center gap-3"
      aria-label={`${site.name} — home`}
    >
      <img
        src="/assets/logo-mark.svg"
        alt=""
        class="h-7 w-7 object-contain transition-transform duration-200 group-hover:rotate-6"
        width="28"
        height="28"
      />
      <span class="font-display text-[0.95rem] font-bold tracking-[0.01em] text-ink">
        SOBAT DUMPIS
      </span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <nav aria-label="Primary navigation">
        <ul class="flex items-center gap-6 lg:gap-8">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`site-nav-link ${isActive(link.href) ? 'is-active' : ''}`.trim()}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <span class="hidden ed-meta lg:block" aria-hidden="true">EST. {site.establishedYear}</span>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="site-mobile-toggle md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open site menu"
    >
      <svg
        class="site-mobile-toggle-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="site-mobile-menu fixed inset-x-0 top-16 z-30 hidden max-h-[calc(100vh-4rem)] overflow-y-auto shadow-[0_24px_40px_-24px_rgba(23,23,23,0.35)] md:hidden"
  aria-hidden="true"
>
  <div class="ed-container">
    <nav aria-label="Mobile navigation">
      <ul class="site-mobile-links">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`site-mobile-link ${isActive(link.href) ? 'is-active' : ''}`.trim()}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="ed-meta mt-6">A little random. A lot of meaning.</p>
  </div>
</div>
