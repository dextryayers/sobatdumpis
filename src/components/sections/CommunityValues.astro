---
import Label from '../ui/Label.astro';

interface Props {
  indexLabel?: string;
  title?: string;
}

const {
  indexLabel = '03 — NILAI KAMI',
  title = 'LIMA HAL YANG KAMI JAGA.',
} = Astro.props;

const values = [
  {
    title: 'Keaslian',
    description: 'Menjadi diri sendiri (gak usah sok jadi orang lain, toh orang lain juga bingung).',
  },
  {
    title: 'Kebersamaan',
    description: 'Berteman yang hangat, saling hargai, dan gak sok misterius.',
  },
  {
    title: 'Rasa Ingin Tahu',
    description: 'Penasaran terus, coba hal baru, dan gak gampang sok tau.',
  },
  {
    title: 'Kebiasaan Berbagi',
    description: 'Berbagi pengalaman, ide, pengetahuan, dan cerita (termasuk cerita cringe).',
  },
  {
    title: 'Positivitas',
    description: 'Ruang yang menyenangkan, suportif, dan gak toxic (kami capek toxic).',
  },
];
---

<section
  class="ed-section border-t border-stone"
  id="community-values"
  aria-labelledby="community-values-title"
>
  <span class="side-rail" aria-hidden="true">Yang kami pegang</span>
  <div class="ed-container grid grid-cols-12 gap-x-6 gap-y-10">
    <div class="col-span-12 md:col-span-4">
      <Label>{indexLabel}</Label>
      <h2
        id="community-values-title"
        class="mt-4 font-display text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.05]"
      >
        {title}
      </h2>
      <p class="ed-meta mt-6 max-w-[28ch]">
        Lima fondasi yang membuat ruang ini tetap hangat, ingin tahu, dan jujur.
      </p>
    </div>

    <ol class="col-span-12 border-t border-ink md:col-span-7 md:col-start-6" data-reveal-group>
      {
        values.map((value, i) => (
          <li class="ed-row">
            <span class="ed-row-index" aria-hidden="true">0{i + 1}</span>
            <h3 class="ed-row-title">{value.title}</h3>
            <p class="ed-row-text">{value.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
