---
import Label from '../ui/Label.astro';
import Button from '../ui/Button.astro';
---

<section class="ed-section relative overflow-hidden" aria-labelledby="hero-title" data-hero>
  <div class="ed-container">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink pb-4">
      <Label>INDEPENDENT COMMUNITY.</Label>
      <span class="ed-meta">EST. 2026 — OPEN TO EVERYONE.</span>
    </div>

    <div class="mt-10 grid grid-cols-12 gap-x-6 gap-y-12 md:mt-14">
      <div class="col-span-12 lg:col-span-8">
        <h1 id="hero-title" class="ed-h1" data-split>
          NOT EVERYONE IS THE SAME.
          <span class="ed-h1-accent">THAT'S THE POINT.</span>
        </h1>
      </div>

      <div class="col-span-12 flex flex-col gap-8 lg:col-span-4 lg:border-l lg:border-stone lg:pl-6">
        <div data-reveal>
          <span class="giant-index" aria-hidden="true">01</span>
          <p class="ed-value mt-5">A little order in a beautifully random world.</p>
        </div>

        <div class="bg-signal p-6 text-paper" data-reveal>
          <p class="font-mono text-[0.6875rem] uppercase tracking-[0.25em]">Community note</p>
          <p class="mt-4 font-display text-2xl font-bold leading-[1.05]">
            DIFFERENT PEOPLE.<br />ONE COMMON SPACE.
          </p>
          <span class="mt-6 block h-px w-10 bg-paper/60" aria-hidden="true"></span>
          <p class="mt-3 font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-paper/80">
            Everyone is welcome here.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-12 items-end gap-x-6 gap-y-10 md:mt-16">
      <div class="col-span-12 md:col-span-7 lg:col-span-6">
        <p class="ed-body max-w-xl" data-reveal>
          Tempat bertemunya berbagai cerita, pemikiran, karakter, dan manusia-manusia
          random. Kami percaya bahwa setiap orang punya cerita yang layak didengar.
        </p>
        <div class="mt-8 flex flex-wrap gap-4" data-reveal>
          <Button href="/people">Meet the People</Button>
          <Button href="/stories" variant="outline">Explore Our Stories</Button>
        </div>
      </div>

      <div class="col-span-12 md:col-span-4 md:col-start-9 lg:col-span-4 lg:col-start-9">
        <ul class="ed-labels" data-reveal>
          <li><Label>OPEN TO EVERYONE.</Label></li>
          <li><Label tone="ink-muted">ESTABLISHED 2026.</Label></li>
          <li><Label tone="ink-muted">A COMMUNITY, NOT A TEMPLATE.</Label></li>
        </ul>
      </div>
    </div>
  </div>
</section>
