---
import Label from '../ui/Label.astro';
import Button from '../ui/Button.astro';
---

<section class="ed-section bg-ink text-paper" id="join-cta" aria-labelledby="join-title">
  <div class="ed-container">
    <h2 id="join-title" class="ed-h2">THERE'S ALWAYS ROOM FOR ONE MORE.</h2>
    <p class="ed-body mt-8 max-w-xl text-stone">
      Kalau kamu suka berbagi cerita, bertemu orang baru, belajar hal baru, atau
      sekadar menjadi diri sendiri, mungkin kamu akan cocok di sini.
    </p>
    <Button href="/join" class="mt-10">Become a Part of Us</Button>
    <Label tone="paper" class="mt-8 block">OPEN TO EVERYONE.</Label>
  </div>
</section>
