---
import { members } from '../../data/members';
import MemberCard from '../editorial/MemberCard.astro';
import Button from '../ui/Button.astro';
import Label from '../ui/Label.astro';
---

<section
  class="ed-section border-t border-stone"
  id="people-preview"
  aria-labelledby="people-preview-title"
>
  <span class="side-rail" aria-hidden="true">Orang-orang kami</span>
  <div class="ed-container">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <Label>04 — ORANG-ORANGNYA</Label>
        <h2 id="people-preview-title" class="ed-h2 mt-4">
          ORANG BERBEDA.<br />
          <span class="ed-h1-accent ed-accent-serif">SATU RUANG YANG SAMA.</span>
        </h2>
      </div>
      <Button href="/people" variant="outline">Kenali Semuanya</Button>
    </div>

    <div
      class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-12 md:gap-6"
      data-reveal-group
    >
      <MemberCard m={members[0]} featured index="01" class="md:col-span-5" />
      <MemberCard m={members[1]} index="02" class="md:col-span-4" />
      <MemberCard m={members[2]} index="03" class="md:col-span-3" />

      <div class="tilt-parent flex flex-col justify-between border border-stone p-6 md:col-span-7" data-tilt="5">
        <p class="ed-statement">"Setiap orang punya cerita yang layak didengar."</p>
        <p class="ed-meta mt-8">Sobat Dumpis — Direktori Orang</p>
      </div>
      <MemberCard m={members[3]} index="04" class="md:col-span-5" />
    </div>
  </div>
</section>
