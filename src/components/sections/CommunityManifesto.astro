---
import Label from '../ui/Label.astro';
---

<section class="ed-manifesto-banner" id="community-manifesto" aria-labelledby="manifesto-title">
  <div class="ed-container">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-paper/30 pb-4">
      <Label tone="paper">07 — MANIFESTO</Label>
      <span class="font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-paper/70">
        Non-negotiable
      </span>
    </div>

    <div class="mt-10 grid grid-cols-12 gap-x-6 gap-y-8">
      <div class="col-span-12 lg:col-span-9">
        <h2 id="manifesto-title" class="ed-h2" data-split>
          WE ARE NOT HERE<br />TO FIT IN.<br />
          <span class="text-ink">WE ARE HERE<br />TO BE OURSELVES.</span>
        </h2>
      </div>
      <div class="col-span-12 flex flex-col justify-between gap-8 lg:col-span-3">
        <span class="font-display text-6xl font-bold leading-none text-paper/30" aria-hidden="true">*</span>
        <p class="ed-value ed-value--paper max-w-xl">
          Setiap orang punya ruang untuk tumbuh, berbagi, tertawa, belajar, dan
          menciptakan sesuatu. Tidak harus menjadi siapa-siapa untuk menjadi bagian
          dari sesuatu.
        </p>
      </div>
    </div>
  </div>
</section>
